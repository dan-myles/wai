{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@wai/telemetry",
  "version": "0.9.2",
  "private": true,
  "type": "module",
  "description": "Collector for wai's opt-in error reports: validates batches and appends them to a JSONL file.",
  "scripts": {
    "start": "bun src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "clean": "git clean -xdf node_modules .cache .turbo"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@wai/oxfmt-config": "workspace:*",
    "@wai/oxlint-config": "workspace:*",
    "@wai/tsconfig": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
